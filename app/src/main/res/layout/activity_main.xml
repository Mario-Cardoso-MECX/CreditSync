<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra Superior (Toolbar) -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:titleTextColor="?attr/colorOnPrimary"
            app:navigationIconTint="?attr/colorOnPrimary"
            app:title="CreditSync" />

        <!-- Carrusel de Tarjetas Apiladas (Efecto Mazo / Stack 3D) -->
        <!-- AJUSTE: Añadido marginTop de 24dp para despegarlo de la barra -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vpTarjetas"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="24dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingStart="40dp"
            android:paddingEnd="40dp" />

        <!-- Panel de Detalles de la Tarjeta Seleccionada -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvResumenTitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resumen del Mes"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Tarjeta 1: Semáforo y Alerta -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <!-- Ícono del Semáforo -->
                        <ImageView
                            android:id="@+id/ivSemaforo"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@android:drawable/presence_online"
                            app:tint="@color/estado_ideal" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:id="@+id/tvEstadoSemaforo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Estado: ✅ Ideal (10%)"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvAlertaPago"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Faltan 18 días para vencer"
                                android:textSize="14sp"
                                android:alpha="0.8" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tarjeta 2: Fechas y Cantidades -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estrategia de Score"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="?attr/colorPrimary" />

                        <!-- Gasto vs Pago -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Gasto total del mes:" />
                            <TextView
                                android:id="@+id/tvGastoTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$1,680.71"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Pagar antes de corte:" />
                            <TextView
                                android:id="@+id/tvPagoAntesCorte"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$899.29"
                                android:textColor="@color/estado_peligro"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Línea separadora -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#33888888"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp" />

                        <!-- Fechas Clave -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Fecha de Corte"
                                    android:textSize="12sp"
                                    android:alpha="0.8" />
                                <TextView
                                    android:id="@+id/tvFechaCorte"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="07 Nov 2026"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="end">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Límite de Pago"
                                    android:textSize="12sp"
                                    android:alpha="0.8" />
                                <TextView
                                    android:id="@+id/tvFechaLimite"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="17 Nov 2026"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Botón para registrar el pago -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPagar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Registrar Abono"
                            app:cornerRadius="8dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- El Menú Lateral -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>